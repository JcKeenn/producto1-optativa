@model List<InventarioWeb.Models.Producto>
@{
    ViewData["Title"] = "Panel de Almacenista";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Panel de Almacenista | Inventario</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Iconos Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <!-- CSS propio -->
    <link rel="stylesheet"
          href="~/css/almacenista.css"
          asp-append-version="true" />
</head>

<body>

    <main class="contenedor">

        <!-- Encabezado -->
        <div class="encabezado">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="logo">
                        <div class="pk-ball pk-ball-sm"></div>
                    </div>

                    <div>
                        <h4 class="mb-0 fw-bold marca">
                            POKÉ<span>MART</span>
                        </h4>

                        <div class="texto-encabezado">
                            Panel de almacenista
                        </div>
                    </div>

                </div>

                <div class="d-flex align-items-center gap-2">

                    <div class="usuario">
                        <i class="bi bi-person-fill"></i>
                        <span>Almacenista</span>
                    </div>

                    <a href="/Login/Index"
                       class="btn btn-outline-light btn-sm rounded-3">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Cerrar sesión
                    </a>

                </div>

            </div>

        </div>

        <!-- Contenido principal -->
        <div class="row g-4">

            <!-- Inventario -->
            <section class="col-12 col-xl-8">
                <div class="tarjeta">

                    <div class="d-flex flex-column flex-md-row
                        justify-content-between align-items-md-center
                        gap-3 mb-4">

                        <div>
                            <h2 class="titulo-seccion mb-1">
                                <i class="bi bi-boxes me-2 text-primary"></i>
                                Inventario actual
                            </h2>
                            <p class="texto-secundario mb-0">
                                Consulta las existencias de los productos.
                            </p>
                        </div>

                        <button type="button"
                                id="btnActualizar"
                                class="btn btn-outline-primary btn-sm rounded-3">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Actualizar

                        </button>

                    </div>

                    <div class="input-group mb-4">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search text-secondary"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               id="buscadorProducto"
                               placeholder="Buscar producto..." />
                    </div>

                    <div class="table-responsive">
                        <table class="table tabla align-middle mb-0" id="tablaProductos">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>Proveedor</th>
                                    <th>Stock</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var producto in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @producto.Id
                                            </span>
                                        </td>
                                        <td>
                                            <span class="icono-producto">
                                                <i class="bi bi-box-seam"></i>
                                            </span>

                                            <span class="fw-semibold">
                                                @producto.Nombre
                                            </span>
                                        </td>

                                        <td>
                                            @producto.NombreCategoria
                                        </td>

                                        <td>
                                            @producto.NombreProveedor
                                        </td>

                                        <td>
                                            @if (producto.StockActual <= producto.StockMinimo)
                                            {
                                                <span class="badge-bajo">
                                                    @producto.StockActual
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-stock">
                                                    @producto.StockActual
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            $@producto.PrecioVenta.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Any(p => p.StockActual <= p.StockMinimo))
                    {
                        <div class="alerta-stock mt-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Hay productos que necesitan reabastecimiento.
                        </div>
                    }

                </div>
            </section>

            <!-- Registrar movimiento -->
            <section class="col-12 col-xl-4">
                <div class="tarjeta">

                    <h2 class="titulo-seccion">
                        <i class="bi bi-arrow-left-right me-2 text-primary"></i>
                        Registrar movimiento
                    </h2>

                    <p class="texto-secundario mb-4">
                        Registra entradas, salidas o ajustes de productos.
                    </p>

                    <form id="formMovimiento"
                         asp-controller="Almacenista"
                          asp-action="RegistrarMovimiento"
                          method="post">

                        <div class="mb-3">
                            <label for="idProducto" class="form-label">
                                Producto
                            </label>

                            <select class="form-select"
                                    id="idProducto"
                                    name="IdProducto"
                                    required>

                                <option value="">Selecciona un producto</option>

                                @foreach (var producto in Model)
                                {
                                    <option value="@producto.Id">
                                        @producto.Id - @producto.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="tipoMovimiento" class="form-label">
                                Tipo de movimiento
                            </label>
                            <select class="form-select"
                                    id="tipoMovimiento"
                                    name="TipoMovimiento"
                                    required>

                                <option value="">Selecciona una opción</option>
                                <option value="ENTRADA">ENTRADA</option>
                                <option value="SALIDA">SALIDA</option>
                                <option value="AJUSTE">AJUSTE</option>

                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="cantidad" class="form-label">
                                Cantidad
                            </label>
                            <input type="number"
                                   class="form-control"
                                   id="cantidad"
                                   name="Cantidad"
                                   min="1"
                                   placeholder="Ej. 5"
                                   required>
                        </div>

                        <div class="mb-4">
                            <label for="motivo" class="form-label">
                                Motivo
                            </label>
                            <textarea class="form-control"
                                      id="motivo"
                                      name="Motivo"
                                      rows="3"
                                      placeholder="Ej. Compra de mercancía"
                                      required></textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-guardar w-100">
                            <i class="bi bi-check-circle me-2"></i>
                            Registrar movimiento
                        </button>
                    </form>

                    <div class="mt-4 p-3 rounded-3 bg-light">
                        <div class="d-flex gap-2 align-items-start">
                            <i class="bi bi-info-circle text-primary"></i>
                            <p class="texto-secundario mb-0">
                                Verifica el producto y la cantidad antes
                                de registrar el movimiento.
                            </p>
                        </div>
                    </div>

                </div>
            </section>

        </div>

        <footer class="text-center mt-4 py-3">
            <p class="texto-secundario mb-0">
                PokéMart · Sistema de Inventario | Neon PostgreSQL
            </p>
        </footer>

    </main>

    <div class="modal fade" id="modalAviso" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitulo">
                        Aviso
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body" id="modalMensaje">
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-primary"
                            data-bs-dismiss="modal">
                        Aceptar
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/almacenista.js"></script>

</body>
</html>