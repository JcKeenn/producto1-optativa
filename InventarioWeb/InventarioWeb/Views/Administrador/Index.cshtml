@{
    ViewData["Title"] = "Panel de Administración";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <!-- CSS personalizado -->
    <link rel="stylesheet"
          href="~/css/Administrador.css"
          asp-append-version="true" />
</head>

<body>

    <div class="admin-container">

        <!-- ENCABEZADO -->
        <header class="admin-header">

            <div class="admin-brand">
                <div class="brand-icon">
                    <div class="pk-ball pk-ball-sm"></div>
                </div>

                <div>
                    <h1>POKÉ<span>MART</span></h1>
                    <p>Panel de administración</p>
                </div>
            </div>

            <div class="admin-actions">

                <div class="admin-user">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Administrador</span>
                </div>

                <a href="/Login/Index"
                   class="btn btn-outline-light btn-sm rounded-3">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Cerrar sesión
                </a>

            </div>

        </header>


        <!-- MENU SUPERIOR -->
        <nav class="admin-navbar">

            <ul class="nav nav-pills admin-menu"
                id="adminTabs"
                role="tablist">

                <!-- PRODUCTOS -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="productos-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#productos"
                            type="button"
                            role="tab"
                            aria-controls="productos"
                            aria-selected="true">

                        <i class="bi bi-box-seam"></i>
                        PRODUCTOS

                    </button>
                </li>

                <!-- CATEGORIAS -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="categorias-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#categorias"
                            type="button"
                            role="tab"
                            aria-controls="categorias"
                            aria-selected="false">

                        <i class="bi bi-tags"></i>
                        CATEGORÍAS

                    </button>
                </li>

                <!-- PROVEEDORES -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="proveedores-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#proveedores"
                            type="button"
                            role="tab"
                            aria-controls="proveedores"
                            aria-selected="false">

                        <i class="bi bi-truck"></i>
                        PROVEEDORES

                    </button>
                </li>

                <!-- USUARIOS -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="usuarios-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#usuarios"
                            type="button"
                            role="tab"
                            aria-controls="usuarios"
                            aria-selected="false">

                        <i class="bi bi-people"></i>
                        USUARIOS

                    </button>
                </li>

                <!-- HISTORIAL -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="historial-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#historial"
                            type="button"
                            role="tab"
                            aria-controls="historial"
                            aria-selected="false">

                        <i class="bi bi-clock-history"></i>
                        HISTORIAL_INVENTARIO

                    </button>
                </li>
                <!-- VENTAS -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="ventas-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#ventas"
                            type="button"
                            role="tab"
                            aria-controls="ventas"
                            aria-selected="false">

                        <i class="bi bi-cart-check"></i>
                        VENTAS

                    </button>
                </li>
            </ul>

        </nav>


        <!-- CONTENIDO PRINCIPAL -->
        <main class="admin-content">

            <div class="tab-content" id="adminTabsContent">

                <!-- ================= PRODUCTOS ================= -->
                <div class="tab-pane fade show active"
                     id="productos"
                     role="tabpanel"
                     aria-labelledby="productos-tab"
                     tabindex="0">

                    
                    <div class="section-heading">

                        <div>
                            <span class="section-label">
                                ADMINISTRACIÓN
                            </span>

                            <h2>Productos</h2>

                            <p>
                                Consulta y administra los productos
                                registrados en el inventario.
                            </p>
                        </div>

                        <div class="productos-menu">

                            <button class="producto-opcion activo"
                                    type="button"
                                    id="btnAgregarProducto">

                                <i class="bi bi-plus-lg"></i>
                                AGREGAR

                            </button>

                            <button class="producto-opcion"
                                    type="button"
                                    id="btnActualizarProducto">

                                <i class="bi bi-pencil-square"></i>
                                ACTUALIZAR

                            </button>

                            <button class="producto-opcion"
                                    type="button"
                                    id="btnEliminarProducto">

                                <i class="bi bi-trash3"></i>
                                ELIMINAR

                            </button>

                        </div>

                    </div>

                    <!-- FORMULARIO AGREGAR PRODUCTO -->

                    <div class="producto-formulario" id="formAgregarProducto">

                        <div class="producto-form-header">

                            <div class="producto-form-titulo">

                                <div class="producto-form-icono">
                                    <i class="bi bi-plus-lg"></i>
                                </div>

                                <div>
                                    <h3>Agregar producto</h3>

                                    <p>
                                        Registra un nuevo producto en el inventario.
                                    </p>
                                </div>

                            </div>

                        </div>


                        <div class="producto-form-body">

                            <div class="row g-3">

                                <!-- CODIGO DE BARRAS -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Código de barras
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="codigoBarras"
                                           placeholder="Ej. 7501234567890">

                                </div>


                                <!-- NOMBRE -->
                                <div class="col-md-8">

                                    <label class="form-label">
                                        Nombre del producto
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="nombreProducto"
                                           placeholder="Ej. Laptop Lenovo">

                                </div>


                                <!-- CATEGORIA -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Categoría
                                    </label>

                                    <select class="form-select"
                                            id="categoriaProducto">
                                        <option value="">
                                            Selecciona una categoría
                                        </option>
                                    </select>

                                </div>


                                <!-- PROVEEDOR -->
                                <div class="col-md-6">

                                    <label class="form-label">
                                        Proveedor
                                    </label>

                                    <select class="form-select"
                                            id="proveedorProducto">
                                        <option value="">
                                            Selecciona un proveedor
                                        </option>
                                    </select>

                                </div>


                                <!-- PRECIO COMPRA -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Precio de compra
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input type="number"
                                               class="form-control"
                                               id="precioCompra"
                                               placeholder="0.00"
                                               min="0"
                                               step="0.01">

                                    </div>

                                </div>


                                <!-- PRECIO VENTA -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Precio de venta
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input type="number"
                                               class="form-control"
                                               id="precioVenta"
                                               placeholder="0.00"
                                               min="0"
                                               step="0.01">

                                    </div>

                                </div>


                                <!-- STOCK MINIMO -->
                                <div class="col-md-4">

                                    <label class="form-label">
                                        Stock mínimo
                                    </label>

                                    <input type="number"
                                           class="form-control"
                                           id="stockMinimo"
                                           placeholder="5"
                                           min="0">

                                </div>


                                <!-- DESCRIPCION -->
                                <div class="col-12">

                                    <label class="form-label">
                                        Descripción
                                    </label>

                                    <textarea class="form-control"
                                              id="descripcionProducto"
                                              rows="3"
                                              placeholder="Descripción del producto..."></textarea>

                                </div>

                            </div>

                        </div>


                        <!-- BOTONES -->

                        <div class="producto-form-footer">

                            <button type="button"
                                    class="btn btn-light btn-cancelar-producto">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </button>

                            <button type="button"
                                    class="btn btn-guardar-producto"
                                    id="btnGuardarProducto">

                                <i class="bi bi-check-lg me-1"></i>
                                Guardar producto

                            </button>

                        </div>

                    </div>

                    <!-- FORMULARIO ACTUALIZAR PRODUCTO -->
                    <div class="producto-formulario" id="formActualizarProducto" style="display: none;">

                        <div class="producto-form-header">
                            <div class="producto-form-titulo">
                                <div class="producto-form-icono">
                                    <i class="bi bi-pencil-square"></i>
                                </div>

                                <div>
                                    <h3>Actualizar producto</h3>
                                    <p>Modifica la información de un producto registrado.</p>
                                </div>
                            </div>
                        </div>

                        <div class="producto-form-body">

                            <div class="row g-3">

                                <!-- ID DEL PRODUCTO -->
                                <div class="col-md-4">
                                    <label class="form-label">Producto</label>

                                    <select class="form-select" id="productoActualizar">
                                        <option value="">Selecciona un producto</option>
                                    </select>
                                </div>

                                <!-- CÓDIGO -->
                                <div class="col-md-4">
                                    <label class="form-label">Código de barras</label>

                                    <input type="text"
                                           class="form-control"
                                           id="codigoActualizar"
                                           placeholder="Código de barras">
                                </div>

                                <!-- NOMBRE -->
                                <div class="col-md-4">
                                    <label class="form-label">Nombre del producto</label>

                                    <input type="text"
                                           class="form-control"
                                           id="nombreActualizar"
                                           placeholder="Nombre del producto">
                                </div>

                                <!-- CATEGORÍA -->
                                <div class="col-md-6">
                                    <label class="form-label">Categoría</label>

                                    <select class="form-select" id="categoriaActualizar">
                                        <option value="">Selecciona una categoría</option>
                                    </select>
                                </div>

                                <!-- PROVEEDOR -->
                                <div class="col-md-6">
                                    <label class="form-label">Proveedor</label>

                                    <select class="form-select" id="proveedorActualizar">
                                        <option value="">Selecciona un proveedor</option>
                                    </select>
                                </div>

                                <!-- PRECIO COMPRA -->
                                <div class="col-md-4">
                                    <label class="form-label">Precio de compra</label>

                                    <div class="input-group">
                                        <span class="input-group-text">$</span>

                                        <input type="number"
                                               class="form-control"
                                               id="precioCompraActualizar"
                                               placeholder="0.00"
                                               min="0"
                                               step="0.01">
                                    </div>
                                </div>

                                <!-- PRECIO VENTA -->
                                <div class="col-md-4">
                                    <label class="form-label">Precio de venta</label>

                                    <div class="input-group">
                                        <span class="input-group-text">$</span>

                                        <input type="number"
                                               class="form-control"
                                               id="precioVentaActualizar"
                                               placeholder="0.00"
                                               min="0"
                                               step="0.01">
                                    </div>
                                </div>

                                <!-- STOCK MÍNIMO -->
                                <div class="col-md-4">
                                    <label class="form-label">Stock mínimo</label>

                                    <input type="number"
                                           class="form-control"
                                           id="stockMinimoActualizar"
                                           placeholder="5"
                                           min="0">
                                </div>

                                <!-- DESCRIPCIÓN -->
                                <div class="col-12">
                                    <label class="form-label">Descripción</label>

                                    <textarea class="form-control"
                                              id="descripcionActualizar"
                                              rows="3"
                                              placeholder="Descripción del producto..."></textarea>
                                </div>

                            </div>

                        </div>

                        <div class="producto-form-footer">

                            <button type="button"
                                    class="btn btn-light btn-cancelar-producto"
                                    id="btnCancelarActualizar">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </button>

                            <button type="button"
                                    class="btn btn-guardar-producto"
                                    id="btnGuardarActualizar">

                                <i class="bi bi-check-lg me-1"></i>
                                Guardar cambios

                            </button>

                        </div>

                    </div>

                    <!-- FORMULARIO ELIMINAR PRODUCTO -->
                    <div class="producto-formulario" id="formEliminarProducto" style="display: none;">

                        <div class="producto-form-header">
                            <div class="producto-form-titulo">
                                <div class="producto-form-icono">
                                    <i class="bi bi-trash3"></i>
                                </div>

                                <div>
                                    <h3>Eliminar producto</h3>
                                    <p>Selecciona el producto que deseas eliminar del inventario.</p>
                                </div>
                            </div>
                        </div>

                        <div class="producto-form-body">

                            <div class="row g-3">

                                <!-- PRODUCTO -->
                                <div class="col-md-6">
                                    <label class="form-label">Producto</label>

                                    <select class="form-select" id="productoEliminar">
                                        <option value="">Selecciona un producto</option>
                                    </select>
                                </div>

                                <!-- ID -->
                                <div class="col-md-3">
                                    <label class="form-label">ID del producto</label>

                                    <input type="text"
                                           class="form-control"
                                           id="idProductoEliminar"
                                           placeholder="ID"
                                           readonly>
                                </div>

                                <!-- CÓDIGO -->
                                <div class="col-md-3">
                                    <label class="form-label">Código de barras</label>

                                    <input type="text"
                                           class="form-control"
                                           id="codigoEliminar"
                                           placeholder="Código"
                                           readonly>
                                </div>

                                <!-- NOMBRE -->
                                <div class="col-md-6">
                                    <label class="form-label">Nombre del producto</label>

                                    <input type="text"
                                           class="form-control"
                                           id="nombreEliminar"
                                           placeholder="Nombre"
                                           readonly>
                                </div>

                                <!-- CATEGORÍA -->
                                <div class="col-md-3">
                                    <label class="form-label">Categoría</label>

                                    <input type="text"
                                       class="form-control"
                                       id="categoriaEliminar"
                                       placeholder="Categoría"
                                       readonly>
                                </div>

                                <!-- PROVEEDOR -->
                                <div class="col-md-3">
                                    <label class="form-label">Proveedor</label>

                                    <input type="text"
                                           class="form-control"
                                           id="proveedorEliminar"
                                           placeholder="Proveedor"
                                           readonly>
                                </div>

                            </div>

                            <!-- AVISO -->
                            <div class="alert alert-warning mt-4 mb-0 d-flex align-items-start gap-2">
                                <i class="bi bi-exclamation-triangle-fill mt-1"></i>

                                <div>
                                    <strong>Atención</strong>
                                    <div class="small">
                                        Esta acción eliminará el producto seleccionado.
                                        Verifica los datos antes de continuar.
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="producto-form-footer">

                            <button type="button"
                                    class="btn btn-light btn-cancelar-producto"
                                    id="btnCancelarEliminar">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </button>

                            <button type="button"
                                    class="btn btn-danger"
                                    id="btnConfirmarEliminar">

                                <i class="bi bi-trash3 me-1"></i>
                                Eliminar producto

                            </button>

                        </div>

                    </div>

                    
                    <!-- TABLA DE PRODUCTOS -->

                    <div class="productos-card">

                        <div class="productos-card-header">

                            <div>
                                <h3>Productos registrados</h3>

                                <p>
                                    Lista de productos disponibles en el inventario.
                                </p>
                            </div>

                            <div class="productos-contador">
                                <i class="bi bi-box-seam"></i>
                                <span id="contadorProductos">0 productos</span>
                            </div>

                        </div>

                        <div class="table-responsive">

                            <table class="table tabla-productos">

                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>CÓDIGO</th>
                                        <th>PRODUCTO</th>
                                        <th>CATEGORÍA</th>
                                        <th>PROVEEDOR</th>
                                        <th>PRECIO COMPRA</th>
                                        <th>PRECIO VENTA</th>
                                        <th>STOCK</th>
                                        <th>STOCK MÍNIMO</th>
                                    </tr>
                                </thead>

                                <tbody id="tablaProductosBody">
                                </tbody>

                            </table>

                        </div>

                    </div>
                    


                </div>


                <!-- ================= CATEGORIAS ================= -->

                <div class="tab-pane fade"
                     id="categorias"
                     role="tabpanel"
                     aria-labelledby="categorias-tab"
                     tabindex="0">

                    <!-- ENCABEZADO -->

                    <div class="section-heading">

                        <div>
                            <span class="section-label">
                                ADMINISTRACIÓN
                            </span>

                            <h2>Categorías</h2>

                            <p>
                                Administra las categorías de los productos
                                registrados en el inventario.
                            </p>
                        </div>

                        <!-- MENU DE OPCIONES -->

                        <div class="productos-menu">

                            <button class="producto-opcion activo"
                                    type="button"
                                    id="btnAgregarCategoria">

                                <i class="bi bi-plus-lg"></i>
                                AGREGAR

                            </button>

                            <button class="producto-opcion"
                                    type="button"
                                    id="btnActualizarCategoria">

                                <i class="bi bi-pencil-square"></i>
                                ACTUALIZAR

                            </button>

                            <button class="producto-opcion"
                                    type="button"
                                    id="btnEliminarCategoria">

                                <i class="bi bi-trash3"></i>
                                ELIMINAR

                            </button>

                        </div>

                    </div>


                    <!-- ===================================== -->
                    <!-- FORMULARIO AGREGAR CATEGORIA          -->
                    <!-- ===================================== -->

                    <div class="producto-formulario"
                         id="formAgregarCategoria">

                        <div class="producto-form-header">

                            <div class="producto-form-titulo">

                                <div class="producto-form-icono">
                                    <i class="bi bi-plus-lg"></i>
                                </div>

                                <div>
                                    <h3>Agregar categoría</h3>

                                    <p>
                                        Registra una nueva categoría
                                        para organizar tus productos.
                                    </p>
                                </div>

                            </div>

                        </div>


                        <div class="producto-form-body">

                            <div class="row g-3">

                                <!-- NOMBRE -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Nombre de la categoría
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="nombreCategoria"
                                           maxlength="100"
                                           placeholder="Ej. Electrónica">

                                    <div class="text-danger small mt-1"
                                         id="errorNombreCategoria"
                                         style="display: none;">
                                    </div>

                                </div>


                                <!-- DESCRIPCION -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Descripción
                                    </label>

                                    <textarea class="form-control"
                                              id="descripcionCategoria"
                                              rows="3"
                                              placeholder="Describe esta categoría..."></textarea>

                                </div>

                            </div>

                        </div>


                        <div class="producto-form-footer">

                            <button type="button"
                                    class="btn btn-light btn-cancelar-categoria"
                                    id="btnCancelarAgregarCategoria">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </button>

                            <button type="button"
                                    class="btn btn-guardar-producto"
                                    id="btnGuardarCategoria">

                                <i class="bi bi-check-lg me-1"></i>
                                Guardar categoría

                            </button>

                        </div>

                    </div>


                    <!-- ===================================== -->
                    <!-- FORMULARIO ACTUALIZAR CATEGORIA       -->
                    <!-- ===================================== -->

                    <div class="producto-formulario"
                         id="formActualizarCategoria"
                         style="display: none;">

                        <div class="producto-form-header">

                            <div class="producto-form-titulo">

                                <div class="producto-form-icono">
                                    <i class="bi bi-pencil-square"></i>
                                </div>

                                <div>
                                    <h3>Actualizar categoría</h3>

                                    <p>
                                        Modifica la información de una
                                        categoría registrada.
                                    </p>
                                </div>

                            </div>

                        </div>


                        <div class="producto-form-body">

                            <div class="row g-3">

                                <!-- SELECCIONAR CATEGORIA -->

                                <div class="col-md-4">

                                    <label class="form-label">
                                        Categoría
                                    </label>

                                    <select class="form-select"
                                            id="categoriaActualizar">

                                        <option value="">
                                            Selecciona una categoría
                                        </option>

                                    </select>

                                    <div class="text-danger small mt-1"
                                         id="errorCategoriaActualizar"
                                         style="display: none;">
                                    </div>

                                </div>


                                <!-- ID -->

                                <div class="col-md-2">

                                    <label class="form-label">
                                        ID
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="idCategoriaActualizar"
                                           placeholder="ID"
                                           readonly>

                                </div>


                                <!-- NOMBRE -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Nombre de la categoría
                                    </label>

                                    <input type="text"
                                           class="form-control"
                                           id="nombreCategoriaActualizar"
                                           maxlength="100"
                                           placeholder="Nombre de la categoría">

                                    <div class="text-danger small mt-1"
                                         id="errorNombreCategoriaActualizar"
                                         style="display: none;">
                                    </div>

                                </div>


                                <!-- DESCRIPCION -->

                                <div class="col-12">

                                    <label class="form-label">
