@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Vendedor | Inventario</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    <!-- CSS Vendedor -->
    <link rel="stylesheet" href="~/css/vendedor.css" />
</head>

<body>

    <!-- ==========================================
         ENCABEZADO
    ========================================== -->

    <div class="encabezado">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

            <!-- LADO IZQUIERDO -->

            <div class="d-flex align-items-center gap-3">

                <div class="logo">

                    <div class="pk-ball pk-ball-sm"></div>

                </div>

                <div>

                    <h4 class="mb-0 fw-bold marca">
                        POKÉ<span>MART</span>
                    </h4>

                    <div class="texto-encabezado">
                        Panel de vendedor
                    </div>

                </div>

            </div>


            <!-- LADO DERECHO -->

            <div class="d-flex align-items-center gap-2">

                <div class="usuario">

                    <i class="bi bi-person-fill"></i>

                    <span>Vendedor</span>

                </div>


                <a href="/Login/CerrarSesion"
                   class="btn btn-outline-light btn-sm rounded-3">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Cerrar sesión
                </a>

            </div>

        </div>

    </div>


    <!-- ==========================================
         CONTENIDO PRINCIPAL
    =========================================== -->

    <main class="vendedor-container">

        <div class="vendedor-grid">


            <!-- ==========================================
                 COLUMNA IZQUIERDA
                 REALIZAR VENTA
            =========================================== -->

            <section class="venta-card">

                <div class="venta-card-header">

                    <div>

                        <h2>
                            <i class="bi bi-cart-plus"></i>
                            Realizar venta
                        </h2>

                        <p>
                            Agrega productos y realiza una nueva venta.
                        </p>

                    </div>

                </div>


                <!-- ==========================================
                     BUSCAR PRODUCTO
                =========================================== -->

                <div class="venta-form">

                    <div class="form-group-vendedor">

                        <label for="buscarProductoVenta">
                            Buscar producto
                        </label>

                        <div class="input-icon">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="buscarProductoVenta"
                                   class="form-control"
                                   placeholder="Buscar por nombre o código...">

                        </div>

                    </div>


                    <!-- ==========================================
                         SELECCIONAR PRODUCTO
                    =========================================== -->

                    <div class="form-group-vendedor">

                        <label for="productoVenta">
                            Producto
                        </label>

                        <select id="productoVenta"
                                class="form-select">

                            <option value="">
                                Seleccionar producto...
                            </option>

                            <option value="1">
                                Charizard Base Set Holo - $550.00
                            </option>

                            <option value="2">
                                Pikachu Base Set - $45.00
                            </option>

                            <option value="3">
                                Mewtwo EX Breakthrough - $220.00
                            </option>

                        </select>

                    </div>


                    <!-- ==========================================
                         CANTIDAD
                    =========================================== -->

                    <div class="form-group-vendedor">

                        <label>
                            Cantidad
                        </label>

                        <div class="cantidad-control">

                            <button type="button"
                                    class="btn-cantidad"
                                    id="btnDisminuirCantidad">

                                <i class="bi bi-dash"></i>

                            </button>

                            <input type="number"
                                   id="cantidadVenta"
                                   value="1"
                                   min="1"
                                   class="cantidad-input">

                            <button type="button"
                                    class="btn-cantidad"
                                    id="btnAumentarCantidad">

                                <i class="bi bi-plus"></i>

                            </button>

                        </div>

                    </div>


                    <!-- ==========================================
                         BOTÓN AGREGAR
                    =========================================== -->

                    <button type="button"
                            class="btn-agregar-carrito"
                            id="btnAgregarCarrito">

                        <i class="bi bi-cart-plus"></i>

                        Agregar al carrito

                    </button>

                </div>


                <!-- ==========================================
                     CARRITO
                =========================================== -->

                <div class="carrito-section">

                    <div class="carrito-header">

                        <div>

                            <h3>
                                <i class="bi bi-cart3"></i>
                                Carrito
                            </h3>

                            <p>
                                Productos de la venta actual.
                            </p>

                        </div>

                        <span class="carrito-contador"
                              id="contadorCarrito">
                            0 productos
                        </span>

                    </div>


                    <div class="carrito-tabla-container">

                        <table class="carrito-tabla">

                            <thead>

                                <tr>

                                    <th>Producto</th>

                                    <th>Cantidad</th>

                                    <th>Precio</th>

                                    <th>Subtotal</th>

                                    <th></th>

                                </tr>

                            </thead>

                            <tbody id="carritoBody">

                                <tr class="carrito-vacio">

                                    <td colspan="5">

                                        <i class="bi bi-cart-x"></i>

                                        <span>
                                            No hay productos en el carrito.
                                        </span>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                    <!-- ==========================================
                         TOTAL
                    =========================================== -->

                    <div class="carrito-total">

                        <span>Total de la venta</span>

                        <strong id="totalVenta">
                            $0.00
                        </strong>

                    </div>


                    <!-- ==========================================
                         BOTONES
                    =========================================== -->

                    <div class="venta-actions">

                        <button type="button"
                                class="btn-cancelar-venta"
                                id="btnCancelarVenta">

                            <i class="bi bi-x-circle"></i>

                            Cancelar

                        </button>

                        <button type="button"
                                class="btn-confirmar-venta"
                                id="btnConfirmarVenta">

                            <i class="bi bi-check-circle"></i>

                            Realizar venta

                        </button>

                    </div>

                </div>

            </section>


            <!-- ==========================================
                 COLUMNA DERECHA
            =========================================== -->

            <div class="columna-derecha-vendedor">


                <!-- ==========================================
                     PRODUCTOS DISPONIBLES
                =========================================== -->

                <section class="productos-card">

                    <div class="productos-card-header">

                        <div>

                            <h2>
                                <i class="bi bi-box-seam"></i>
                                Productos disponibles
                            </h2>

                            <p>
                                Consulta los productos disponibles en inventario.
                            </p>

                        </div>

                        <div class="productos-contador">

                            <i class="bi bi-box"></i>

                            <span id="contadorProductos">
                                0 productos
                            </span>

                        </div>

                    </div>


                    <!-- BUSCADOR -->

                    <div class="tabla-buscador">

                        <div class="input-icon">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="buscarProductos"
                                   class="form-control"
                                   placeholder="Buscar producto...">

                        </div>

                    </div>


                    <!-- TABLA -->

                    <div class="tabla-container">

                        <table class="tabla-vendedor">

                            <thead>

                                <tr>

                                    <th>ID</th>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th>Stock</th>

                                </tr>

                            </thead>

                            <tbody id="tablaProductosBody">

                                <tr>

                                    <td>1</td>

                                    <td>
                                        Charizard Base Set Holo 4/102
                                    </td>

                                    <td>
                                        $550.00
                                    </td>

                                    <td>
                                        <span class="stock-disponible">
                                            3
                                        </span>
                                    </td>

                                </tr>

                                <tr>

                                    <td>4</td>

                                    <td>
                                        Pikachu Base Set 58/102
                                    </td>

                                    <td>
                                        $45.00
                                    </td>

                                    <td>
                                        <span class="stock-disponible">
                                            20
                                        </span>
                                    </td>

                                </tr>

                                <tr>

                                    <td>6</td>

                                    <td>
                                        Gengar EX Phantom Forces 34/119
                                    </td>

                                    <td>
                                        $260.00
                                    </td>

                                    <td>
                                        <span class="stock-bajo">
                                            2
                                        </span>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </section>


                <!-- ==========================================
                     VENTAS REALIZADAS
                =========================================== -->

                <section class="ventas-card">

                    <div class="ventas-card-header">

                        <div>

                            <h2>
                                <i class="bi bi-receipt"></i>
                                Ventas realizadas
                            </h2>

                            <p>
                                Consulta las ventas realizadas.
                            </p>

                        </div>

                        <div class="ventas-contador">

                            <i class="bi bi-receipt-cutoff"></i>

                            <span id="contadorVentas">
                                0 ventas
                            </span>

                        </div>

                    </div>


                    <!-- BUSCADOR -->

                    <div class="tabla-buscador">

                        <div class="input-icon">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="buscarVentas"
                                   class="form-control"
                                   placeholder="Buscar venta...">

                        </div>

                    </div>


                    <!-- TABLA -->

                    <div class="tabla-container">

                        <table class="tabla-vendedor">

                            <thead>

                                <tr>

                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th>Acción</th>

                                </tr>

                            </thead>

                            <tbody id="tablaVentasBody">

                                <tr>

                                    <td>15</td>

                                    <td>
                                        07/10/2026 12:30
                                    </td>

                                    <td>
                                        $1,750.00
                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn-ver-venta">

                                            <i class="bi bi-eye"></i>

                                            Ver

                                        </button>

                                    </td>

                                </tr>

                                <tr>

                                    <td>14</td>

                                    <td>
                                        07/10/2026 11:45
                                    </td>

                                    <td>
                                        $265.00
                                    </td>

                                    <td>

                                        <button type="button"
                                                class="btn-ver-venta">

                                            <i class="bi bi-eye"></i>

                                            Ver

                                        </button>

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </section>

            </div>

        </div>

    </main>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- JS Vendedor -->

    <script src="~/js/vendedor.js"></script>

</body>

</html>